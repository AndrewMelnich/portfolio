---
import Dropdown from './Dropdown.astro';
import type { Props as DropdownProps } from './Dropdown.astro';

type Props = DropdownProps & {
    triggerLabel: string;
};

const { triggerLabel, ...dropdownProps } = Astro.props;
---

<Dropdown {...dropdownProps}>
    <button type="button" class="dropdown-toggler js-dropdown-toggler" slot="trigger">
        {triggerLabel}
    </button>
    <div slot="content" class="dropdown-menu">
        <button type="button">Пункт 1</button>
        <button type="button">Пункт 2</button>
    </div>
</Dropdown>
