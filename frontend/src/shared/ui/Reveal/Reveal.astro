---
export interface Props {
    type?: string;
    delay?: number;
    allowed?: boolean;
    instant?: boolean;
    once?: boolean;
    direction?: 'up' | 'down';
}

const { type, delay = 0, allowed = true, instant = false, once = true, direction = 'up', ...rest } = Astro.props;
---

<reveal-element
    data-reveal
    data-reveal-type={type}
    data-reveal-direction={direction}
    data-reveal-delay={delay}
    data-reveal-allowed={allowed}
    data-reveal-instant={instant}
    data-reveal-once={once}
    class="reveal-element"
    {...rest}
>
    <slot />
</reveal-element>

<style lang="scss" is:global>
    @use './Reveal';
</style>

<script>
    import Reveal from './Reveal';

    Reveal.init();
</script>
