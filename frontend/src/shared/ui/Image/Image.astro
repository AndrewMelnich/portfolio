---
import type { HTMLAttributes } from 'astro/types';
import { Image as AstroImage } from 'astro:assets';
import { SSR_ENABLED } from '@/../config.js';
import { resolveStorageUrl } from '@/shared/api/resolve-storage-url';
import { widths } from './const';
import { createSrcset } from './utils/create-srcset';
import imageLoader from './utils/image-loader';

export type Props = HTMLAttributes<'img'> & {
    src: string;
    alt: string;
    width: number;
    height: number;
    format?: 'webp' | 'avif';
    quality?: number;
    loading?: 'lazy' | 'eager';
    decoding?: 'async' | 'sync' | 'auto';
    sizes?: string;
    resize?: boolean;
    priority?: boolean;
    widths?: number[];
};

const {
    src,
    alt,
    width,
    height,
    format = 'webp',
    quality = 80,
    loading = 'lazy',
    decoding = 'async',
    sizes = '100vw',
    priority = false,
    widths: widthsProp,
    ...props
} = Astro.props;

const responsiveWidths = [...new Set([...(widthsProp ?? widths).filter((value) => value <= width), width])].sort(
    (a, b) => a - b,
);
const optimizedSrc = imageLoader({ src, width, quality, format });
const srcset = createSrcset(src, responsiveWidths, quality, format);
---

{SSR_ENABLED || src.endsWith('.svg') ? (
    <img
        src={resolveStorageUrl(optimizedSrc)}
        srcset={src.endsWith('.svg') ? undefined : srcset}
        alt={alt}
        width={width}
        height={height}
        loading={priority ? 'eager' : loading}
        decoding={decoding}
        sizes={sizes}
        fetchpriority={priority ? 'high' : undefined}
        {...props}
    />
) : (
    <AstroImage
        src={{
            src,
            width,
            height,
            format,
        }}
        alt={alt}
        widths={responsiveWidths}
        quality={quality}
        layout="full-width"
        sizes={sizes}
        loading={priority ? 'eager' : loading}
        decoding={decoding}
        fetchpriority={priority ? 'high' : undefined}
        {...props}
    />
)}
