---
export interface Props extends astroHTML.JSX.InputHTMLAttributes {
    /**
     * Иконка
     */
    icon?: HTMLElement;
    /**
     * Лейбл (описание)
     */
    label: string;
    /**
     * Нужно ли спрятать лейбл
     */
    hideLabel?: boolean;
    /**
     * Рендерить ли сообщение
     */
    showMessage?: boolean;
    /**
     * Класс инпута
     */
    inputClassName?: string;
}

const { id, label, hideLabel = false, showMessage = true, icon, inputClassName, type = 'text', ...props } = Astro.props;
---

<div class:list={['text-caption', 'input-group', 'js-input-group', props.class]}>
    <input
        id={id}
        type={type}
        class:list={['form-control', 'js-form-control', 'floated-labels', inputClassName]}
        data-testid="input"
        {...props}
    />
    <label for={id} class:list={['form-label', 'js-form-label', { 'visually-hidden': hideLabel }]}>
        {label}
    </label>
    {icon && <div class="input-group__icon">{icon}</div>}
    {showMessage && <div class="app-message js-app-message text-caption-sm" aria-live="polite" aria-describedby={id} />}
</div>

<style lang="scss" is:global>
    @use './Input';
</style>

<script>
    import Input from './Input';

    Input.init();
</script>
