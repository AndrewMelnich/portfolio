---
import type { HTMLAttributes } from 'astro/types';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { LOCALES, type AppLocale } from '@/shared/config';
import { tp } from '@/shared/lib/formatting';

type Props = HTMLAttributes<'header'>;

const { class: className, ...props } = Astro.props;
const locale = Astro.currentLocale as AppLocale;
const homeHref = getRelativeLocaleUrl(locale, '/');
const currentPath = Astro.url.pathname;
const currentHash = Astro.url.hash.replace(/^#/, '');
const homeLabel = locale === 'en' ? 'Home' : 'Главная';
const isHomeCurrent = homeHref === currentPath;

const isNavCurrent = (href: string) => {
    const hashIndex = href.indexOf('#');

    if (hashIndex !== -1) {
        return Boolean(currentHash) && href.slice(hashIndex + 1) === currentHash;
    }

    if (currentHash) return false;

    return href === currentPath;
};

const navItems = [
    {
        href: homeHref,
        label: homeLabel,
    },
    {
        href: `${homeHref}#about`,
        label: locale === 'en' ? 'About' : 'Обо мне',
    },
    {
        href: `${homeHref}#work`,
        label: locale === 'en' ? 'Cases' : 'Кейсы',
    },

    {
        href: `${homeHref}#contact`,
        label: locale === 'en' ? 'Contact' : 'Контакт',
    },
] as const;

const pathWithoutLocale = Astro.url.pathname.replace(/^\/en(?=\/|$)/, '') || '/';

const localeHref = (target: AppLocale) => getRelativeLocaleUrl(target, pathWithoutLocale);

const localeLabels: Record<AppLocale, string> = {
    ru: 'RU',
    en: 'EN',
};

const defaultLogoId = '07-signal';
const defaultLogoFile = '07-signal.svg';
---

<header class:list={['header', 'js-header', className]} {...props}>
    <div class="header__inner wrapper">
        <span class="header__logo-reveal" data-reveal="instant" data-reveal-sticky>
            <a
                class:list={[
                    'header__logo',
                    'header__logo--wide',
                    'js-header-logo',
                    { 'header__logo--current': isHomeCurrent },
                ]}
                href={homeHref}
                aria-label={homeLabel}
                data-default-logo={defaultLogoId}
                style={`--header-logo-w: 142px; --header-logo-h: 36px; --header-logo-src: url('/static/img/logos/${defaultLogoFile}')`}
            >
                <span class="header__logo-mark js-header-logo-mark" aria-hidden="true"></span>
            </a>
        </span>
        <div class="header__end">
            <nav class="header__nav js-header-nav" aria-label="Primary">
                <ul class="header__list list-unstyled">
                    {navItems.map((item) => (
                        <li>
                            <a
                                class:list={[
                                    'header__link',
                                    'js-header__link',
                                    'label-m',
                                    { 'header__link--current': isNavCurrent(item.href) },
                                ]}
                                href={item.href}
                                aria-current={
                                    isNavCurrent(item.href)
                                        ? item.href.includes('#')
                                            ? 'location'
                                            : 'page'
                                        : undefined
                                }
                                data-press
                                data-reveal="scatter-instant"
                                data-reveal-sticky
                                data-reveal-delay="0.12"
                            >
                                {tp(item.label, locale)}
                            </a>
                        </li>
                    ))}
                </ul>
            </nav>
            <nav class="header__langs" aria-label={locale === 'en' ? 'Language' : 'Язык'}>
                <ul class="header__langs-list list-unstyled">
                    {LOCALES.map((item) => (
                        <li>
                            {item === locale ? (
                                <span
                                    class="header__link header__link--current label-m"
                                    aria-current="true"
                                    data-reveal="scatter-instant"
                                    data-reveal-sticky
                                    data-reveal-delay="0.12"
                                >
                                    {localeLabels[item]}
                                </span>
                            ) : (
                                <a
                                    class="header__link label-m"
                                    href={localeHref(item)}
                                    hreflang={item}
                                    lang={item}
                                    data-press
                                    data-reveal="scatter-instant"
                                    data-reveal-sticky
                                    data-reveal-delay="0.12"
                                >
                                    {localeLabels[item]}
                                </a>
                            )}
                        </li>
                    ))}
                </ul>
            </nav>
        </div>
    </div>
</header>

<style lang="scss" is:global>
    @use './Header';
</style>

<script>
    const STORAGE_KEY = 'portfolio-logo-id-v2';
    const WIDE_LOGOS = new Set(['04-wordmark', '07-signal']);
    const LOGO_SIZE: Record<string, { width: number; height: number }> = {
        '01-framed-square': { width: 36, height: 36 },
        '02-am-monogram': { width: 36, height: 36 },
        '03-touch-nodes': { width: 36, height: 36 },
        '04-wordmark': { width: 140, height: 20 },
        '05-letter-m': { width: 36, height: 36 },
        '06-focus-square': { width: 36, height: 36 },
        '07-signal': { width: 142, height: 36 },
    };
    const LOGO_FILES: Record<string, string> = {
        '01-framed-square': '01-framed-square.svg',
        '02-am-monogram': '02-am-monogram.svg',
        '03-touch-nodes': '03-touch-nodes.svg',
        '04-wordmark': '04-wordmark.svg',
        '05-letter-m': '05-letter-m.svg',
        '06-focus-square': '06-focus-square.svg',
        '07-signal': '07-signal.svg',
    };
    const LINK_CURRENT = 'header__link--current';
    const LOGO_CURRENT = 'header__logo--current';
    const SECTION_IDS = ['work', 'about', 'contact'] as const;

    let sectionObserver: IntersectionObserver | null = null;
    let activeSection: string | null = null;
    let visibleSections = new Set<string>();

    const applyLogo = () => {
        const link = document.querySelector<HTMLElement>('.js-header-logo');

        if (!link) return;

        const id = localStorage.getItem(STORAGE_KEY) || link.dataset.defaultLogo || '07-signal';
        const wide = WIDE_LOGOS.has(id);
        const file = LOGO_FILES[id] ?? `${id}.svg`;
        const size = LOGO_SIZE[id] ?? { width: 36, height: 36 };

        link.style.setProperty('--header-logo-src', `url('/static/img/logos/${file}')`);
        link.style.setProperty('--header-logo-w', `${size.width}px`);
        link.style.setProperty('--header-logo-h', `${size.height}px`);
        link.classList.toggle('header__logo--wide', wide);
    };

    const navLinks = () => [...document.querySelectorAll<HTMLAnchorElement>('.js-header-nav .js-header__link')];

    const applyCurrent = (sectionId: string | null) => {
        const path = window.location.pathname;

        for (const link of navLinks()) {
            const url = new URL(link.href, window.location.href);
            const hash = url.hash.slice(1);
            const on = sectionId ? hash === sectionId : !hash && url.pathname === path;

            if (link.classList.contains(LINK_CURRENT) === on) continue;

            link.classList.toggle(LINK_CURRENT, on);

            if (on) {
                link.setAttribute('aria-current', hash ? 'location' : 'page');
            } else {
                link.removeAttribute('aria-current');
            }
        }

        const logo = document.querySelector<HTMLAnchorElement>('.js-header-logo');

        if (!logo) return;

        const homePath = new URL(logo.href, window.location.href).pathname;

        logo.classList.toggle(LOGO_CURRENT, homePath === path);
    };

    const resolveVisibleSection = () => {
        let next: string | null = null;

        for (const id of SECTION_IDS) {
            if (visibleSections.has(id)) next = id;
        }

        if (next === activeSection) return;

        activeSection = next;
        applyCurrent(next);
    };

    const syncFromHash = () => {
        const hash = window.location.hash.slice(1);

        if (hash && (SECTION_IDS as readonly string[]).includes(hash) && document.getElementById(hash)) {
            activeSection = hash;
            applyCurrent(hash);

            return;
        }

        activeSection = null;
        applyCurrent(null);
    };

    const setupNavCurrent = () => {
        sectionObserver?.disconnect();
        sectionObserver = null;
        visibleSections = new Set();
        activeSection = null;

        const sections = SECTION_IDS.map((id) => document.getElementById(id)).filter((node): node is HTMLElement =>
            Boolean(node),
        );

        if (!sections.length) {
            syncFromHash();

            return;
        }

        const headerHeight = Number.parseFloat(
            getComputedStyle(document.documentElement).getPropertyValue('--header-height'),
        );
        const topInset = Number.isFinite(headerHeight) ? headerHeight : 94;

        sectionObserver = new IntersectionObserver(
            (entries) => {
                for (const entry of entries) {
                    if (entry.isIntersecting) {
                        visibleSections.add(entry.target.id);
                    } else {
                        visibleSections.delete(entry.target.id);
                    }
                }

                resolveVisibleSection();
            },
            {
                rootMargin: `-${topInset}px 0px -45% 0px`,
                threshold: 0,
            },
        );

        for (const section of sections) {
            sectionObserver.observe(section);
        }

        syncFromHash();
    };

    const onHeaderClick = (event: MouseEvent) => {
        const target = event.target;

        if (!(target instanceof Element)) return;

        const link = target.closest<HTMLAnchorElement>('a.js-header-logo, .js-header-nav a.js-header__link');

        if (!link) return;

        const url = new URL(link.href, window.location.href);

        if (url.pathname !== window.location.pathname || url.hash.length > 1) return;

        event.preventDefault();

        if (window.scrollY > 0 || window.location.hash) {
            window.history.replaceState(null, '', url.pathname + url.search);
            window.scrollTo({ top: 0, left: 0, behavior: 'smooth' });
            activeSection = null;
            applyCurrent(null);
        }
    };

    const bootNavCurrent = () => {
        requestAnimationFrame(() => {
            setupNavCurrent();
        });
    };

    applyLogo();
    bootNavCurrent();
    window.addEventListener('storage', applyLogo);
    window.addEventListener('hashchange', syncFromHash);
    document.addEventListener('astro:page-load', () => {
        applyLogo();
        bootNavCurrent();
    });
    document.addEventListener('click', onHeaderClick);
</script>
