---
import type { HTMLAttributes } from 'astro/types';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { DEFAULT_LOCALE, LOCALES, type AppLocale } from '@/shared/config';
import { tp } from '@/shared/lib/formatting';

type Props = HTMLAttributes<'header'>;

const { class: className, ...props } = Astro.props;
const locale = Astro.currentLocale as AppLocale;
const homeHref = getRelativeLocaleUrl(locale, '/');

const navItems = [
    {
        href: homeHref,
        label: locale === 'en' ? 'Home' : 'Главная',
    },
    {
        href: getRelativeLocaleUrl(locale, '/cases'),
        label: locale === 'en' ? 'Cases' : 'Кейсы',
    },
    {
        href: `${homeHref}#about`,
        label: locale === 'en' ? 'About' : 'Обо мне',
    },
    {
        href: `${homeHref}#contact`,
        label: locale === 'en' ? 'Contact' : 'Контакт',
    },
] as const;

const pathWithoutLocale = Astro.url.pathname.replace(/^\/en(?=\/|$)/, '') || '/';

const localeHref = (target: AppLocale) => {
    if (target === DEFAULT_LOCALE) {
        return pathWithoutLocale;
    }

    return pathWithoutLocale === '/' ? `/${target}` : `/${target}${pathWithoutLocale}`;
};

const localeLabels: Record<AppLocale, string> = {
    ru: 'RU',
    en: 'EN',
};

const defaultLogoId = '07-signal';
const defaultLogoFile = '07-signal.svg';
---

<header class:list={['header', 'js-header', className]} {...props}>
    <div class="header__inner wrapper">
        <span class="header__logo-reveal" data-reveal="instant" data-reveal-sticky>
            <a
                class="header__logo header__logo--wide js-header-logo"
                href={homeHref}
                aria-label={locale === 'en' ? 'Home' : 'Главная'}
                data-default-logo={defaultLogoId}
                style="

--header-logo-w: 142px; --header-logo-h: 36px"
            >
                <img
                    class="header__logo-mark js-header-logo-mark"
                    src={`/static/img/logos/${defaultLogoFile}`}
                    alt=""
                    width="142"
                    height="36"
                />
            </a>
        </span>
        <div class="header__end">
            <nav class="header__nav" aria-label="Primary">
                <ul class="header__list list-unstyled">
                    {navItems.map((item) => (
                        <li>
                            <a
                                class="header__link label-m"
                                href={item.href}
                                data-press
                                data-reveal="scatter-instant"
                                data-reveal-sticky
                                data-reveal-delay="0.12"
                            >
                                {tp(item.label, locale)}
                            </a>
                        </li>
                    ))}
                </ul>
            </nav>
            <nav class="header__langs" aria-label={locale === 'en' ? 'Language' : 'Язык'}>
                <ul class="header__langs-list list-unstyled">
                    {LOCALES.map((item) => (
                        <li>
                            {item === locale ? (
                                <span
                                    class="header__link header__link--current label-m"
                                    aria-current="true"
                                    data-reveal="scatter-instant"
                                    data-reveal-sticky
                                    data-reveal-delay="0.12"
                                >
                                    {localeLabels[item]}
                                </span>
                            ) : (
                                <a
                                    class="header__link label-m"
                                    href={localeHref(item)}
                                    hreflang={item}
                                    lang={item}
                                    data-press
                                    data-reveal="scatter-instant"
                                    data-reveal-sticky
                                    data-reveal-delay="0.12"
                                >
                                    {localeLabels[item]}
                                </a>
                            )}
                        </li>
                    ))}
                </ul>
            </nav>
        </div>
    </div>
</header>

<style lang="scss" is:global>
    @use './Header';
</style>

<script>
    const STORAGE_KEY = 'portfolio-logo-id-v2';
    const WIDE_LOGOS = new Set(['04-wordmark', '07-signal']);
    const LOGO_SIZE: Record<string, { width: number; height: number }> = {
        '01-framed-square': { width: 36, height: 36 },
        '02-am-monogram': { width: 36, height: 36 },
        '03-touch-nodes': { width: 36, height: 36 },
        '04-wordmark': { width: 140, height: 20 },
        '05-letter-m': { width: 36, height: 36 },
        '06-focus-square': { width: 36, height: 36 },
        '07-signal': { width: 142, height: 36 },
    };
    const LOGO_FILES: Record<string, string> = {
        '01-framed-square': '01-framed-square.svg',
        '02-am-monogram': '02-am-monogram.svg',
        '03-touch-nodes': '03-touch-nodes.svg',
        '04-wordmark': '04-wordmark.svg',
        '05-letter-m': '05-letter-m.svg',
        '06-focus-square': '06-focus-square.svg',
        '07-signal': '07-signal.svg',
    };

    const applyLogo = () => {
        const link = document.querySelector<HTMLAnchorElement>('.js-header-logo');
        const mark = document.querySelector<HTMLImageElement>('.js-header-logo-mark');

        if (!link || !mark) return;

        const id = localStorage.getItem(STORAGE_KEY) || link.dataset.defaultLogo || '07-signal';
        const wide = WIDE_LOGOS.has(id);
        const file = LOGO_FILES[id] ?? `${id}.svg`;
        const size = LOGO_SIZE[id] ?? { width: 36, height: 36 };

        mark.src = `/static/img/logos/${file}`;
        mark.width = size.width;
        mark.height = size.height;
        link.style.setProperty('--header-logo-w', `${size.width}px`);
        link.style.setProperty('--header-logo-h', `${size.height}px`);
        link.classList.toggle('header__logo--wide', wide);
    };

    applyLogo();
    window.addEventListener('storage', applyLogo);
</script>
