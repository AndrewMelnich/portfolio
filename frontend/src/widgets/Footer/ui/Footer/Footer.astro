---
import type { HTMLAttributes } from 'astro/types';
import type { AppLocale } from '@/shared/config';
import { SOCIALS } from '@/shared/config';
import { tp } from '@/shared/lib/formatting';

type Props = HTMLAttributes<'footer'>;

const { class: className, ...props } = Astro.props;
const locale = Astro.currentLocale as AppLocale;
const year = new Date().getFullYear();

const tagline =
    locale === 'en'
        ? 'Digital products and interfaces — from mockup to code'
        : 'Цифровые продукты и интерфейсы — от макета до кода';
---

<footer class:list={['footer', className]} {...props}>
    <div class="footer__inner wrapper">
        <p class="footer__name text-l" data-reveal="instant" data-reveal-delay="0.08">
            {tp('Andrew Melnichenko', locale)}
        </p>
        <p class="footer__tagline text-s" data-reveal="instant" data-reveal-delay="0.16">
            {tp(tagline, locale)}
        </p>
        <div class="footer__meta">
            <ul class="footer__socials list-unstyled">
                {SOCIALS.map((item, index) => (
                    <li data-reveal="instant" data-reveal-delay={0.24 + index * 0.08}>
                        <a
                            class="footer__social link label-m"
                            href={item.href}
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            {tp(item.label, locale)}
                        </a>
                    </li>
                ))}
            </ul>
            <p class="footer__copy text-xs">{tp(`© ${year} Andrew Melnichenko.`, locale)}</p>
        </div>
    </div>
</footer>

<style lang="scss" is:global>
    @use './Footer';
</style>
