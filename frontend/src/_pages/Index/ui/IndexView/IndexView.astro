---
import type { HTMLAttributes } from 'astro/types';
import type { AppLocale } from '@/shared/config';
import About from './sections/About';
import Contact from './sections/Contact';
import FeaturedCases from './sections/FeaturedCases';
import Hero from './sections/Hero';
import SoftSkills from './sections/SoftSkills';
import type { RawProps } from './types';

type Props = HTMLAttributes<'div'> & RawProps;

const { class: className, ...props } = Astro.props;
const locale = Astro.currentLocale as AppLocale;
---

<div class:list={['index-view', className]} {...props}>
    <Hero />
    <About />
    <SoftSkills />
    <FeaturedCases />
    <Contact locale={locale} />
</div>

<style lang="scss" is:global>
    @use './styles';
</style>
