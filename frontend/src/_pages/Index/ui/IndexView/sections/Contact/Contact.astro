---
import type { HTMLAttributes } from 'astro/types';
import { SOCIALS } from '@/shared/config';
import { tp } from '@/shared/lib/formatting';
import Input from '@/shared/ui/Input';
import Textarea from '@/shared/ui/Textarea';
import type { RawProps } from './types';

type Props = HTMLAttributes<'section'> & RawProps;

const { locale, class: className, ...props } = Astro.props;

const title = locale === 'ru' ? 'Написать' : 'Get in touch';
const text =
    locale === 'ru'
        ? 'Расскажите про задачу и сроки — отвечу в Telegram или по почте.'
        : 'Tell me about the task and timeline — I will reply on Telegram or by email.';
const nameLabel = locale === 'ru' ? 'Имя' : 'Name';
const contactLabel = locale === 'ru' ? 'Email или Telegram' : 'Email or Telegram';
const messageLabel = locale === 'ru' ? 'Сообщение' : 'Message';
const submitLabel = locale === 'ru' ? 'Отправить' : 'Send';
const socialsNote = locale === 'ru' ? 'Или сразу:' : 'Or directly:';
const statusSuccess =
    locale === 'ru'
        ? 'Спасибо! Форма пока работает в демо-режиме — быстрее написать в Telegram.'
        : 'Thanks! This form is in demo mode for now — Telegram is the fastest way to reach me.';
const statusInvalid = locale === 'ru' ? 'Заполните обязательные поля.' : 'Please fill in the required fields.';

const socials = SOCIALS.filter((item) => item.id === 'telegram' || item.id === 'instagram');
---

<section class:list={['contact', 'wrapper', className]} {...props} id="contact">
    <h2 class="contact__title" id="contact-title">
        {tp(title, locale)}
    </h2>
    <p class="contact__text">{tp(text, locale)}</p>

    <form
        class="contact__form js-contact-form"
        novalidate
        data-status-success={statusSuccess}
        data-status-invalid={statusInvalid}
    >
        <Input id="contact-name" name="name" label={nameLabel} autocomplete="name" required />
        <Input id="contact-contact" name="contact" label={contactLabel} required />
        <Textarea id="contact-message" name="message" label={messageLabel} required variant="dark" rows={6} />
        <button class="contact__submit" type="submit">
            {tp(submitLabel, locale)}
        </button>
        <p class="contact__status js-contact-status" aria-live="polite"></p>
    </form>

    <div class="contact__socials">
        <p class="contact__socials-note">{tp(socialsNote, locale)}</p>
        <ul class="contact__socials-list list-unstyled">
            {socials.map((item) => (
                <li>
                    <a class="contact__social-link link" href={item.href} target="_blank" rel="noopener noreferrer">
                        {item.label}
                    </a>
                </li>
            ))}
        </ul>
    </div>
</section>

<style lang="scss" is:global>
    @use './Contact';
</style>

<script>
    document.querySelectorAll<HTMLFormElement>('.js-contact-form').forEach((form) => {
        form.addEventListener('submit', (event) => {
            event.preventDefault();

            const status = form.querySelector<HTMLParagraphElement>('.js-contact-status');
            const fields = form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[required]');
            let firstInvalid: HTMLInputElement | HTMLTextAreaElement | null = null;

            fields.forEach((field) => {
                const empty = field.value.trim() === '';

                field.setAttribute('aria-invalid', String(empty));

                if (empty && firstInvalid === null) {
                    firstInvalid = field;
                }
            });

            if (firstInvalid) {
                if (status) {
                    status.textContent = form.dataset.statusInvalid ?? '';
                }

                firstInvalid.focus();

                return;
            }

            if (status) {
                status.textContent = form.dataset.statusSuccess ?? '';
            }
        });
    });
</script>
