---
import type { HTMLAttributes } from 'astro/types';
import { SOCIALS } from '@/shared/config';
import { tp } from '@/shared/lib/formatting';
import type { RawProps } from './types';

type Props = HTMLAttributes<'section'> & RawProps;

const { locale, class: className, ...props } = Astro.props;

const title = locale === 'ru' ? 'Связаться со мной' : 'Get in touch';
const text =
    locale === 'ru'
        ? 'Напишите идею или задачу — разберёмся, оценю объём и отвечу в Telegram или на почту.'
        : "Share an idea or a task — we'll sort it out, I'll estimate the scope, and reply on Telegram or email.";

const telegram = SOCIALS.find((item) => item.id === 'telegram');

const channels = [
    {
        id: 'email',
        label: 'Email',
        href: 'mailto:andrew.melnich@yandex.ru',
        value: 'andrew.melnich@yandex.ru',
        external: false,
    },
    {
        id: 'telegram',
        label: 'Telegram',
        href: telegram?.href ?? 'https://t.me/andrew_melnich',
        value: '@andrew_melnich',
        external: true,
    },
] as const;
---

<section
    class:list={['contact', 'wrapper', className]}
    data-key-visual-shape="/static/img/key-visual-contact.jpg"
    {...props}
    id="contact"
>
    <h2 class="contact__title h2" id="contact-title" data-reveal="scatter" data-reveal-delay="0.08">
        {tp(title, locale)}
    </h2>
    <p class="contact__text text-m" data-reveal="instant" data-reveal-delay="0.16">
        {tp(text, locale)}
    </p>

    <ul class="contact__channels list-unstyled">
        {channels.map((item, index) => (
            <li class="contact__channel" data-reveal="instant" data-reveal-delay={0.24 + index * 0.08}>
                <span class="contact__channel-label label">{item.label}</span>
                <a
                    class="contact__channel-link text-xl link"
                    href={item.href}
                    target={item.external ? '_blank' : undefined}
                    rel={item.external ? 'noopener noreferrer' : undefined}
                    data-press
                >
                    {item.value}
                </a>
            </li>
        ))}
    </ul>
</section>

<style lang="scss" is:global>
    @use './Contact';
</style>
