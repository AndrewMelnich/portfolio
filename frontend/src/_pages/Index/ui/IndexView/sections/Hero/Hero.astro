---
import type { HTMLAttributes } from 'astro/types';
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { AppLocale } from '@/shared/config';
import { tp } from '@/shared/lib/formatting';
import type { RawProps } from './types';

type Props = HTMLAttributes<'section'> & RawProps;

const { ...props } = Astro.props;
const locale = Astro.currentLocale as AppLocale;

const copy = {
    ru: {
        lead: 'Креативные сайты под ваши задачи',
        subline: 'Лендинги, многостраничники и плотные интерфейсы — аккуратно до прода.',
        cases: 'Смотреть работы',
        contact: 'Обсудить задачу',
    },
    en: {
        lead: 'Creative sites shaped around your brief',
        subline: 'Landings, multi-page sites, denser UI — careful work that reaches production.',
        cases: 'See the work',
        contact: 'Discuss a project',
    },
}[locale];

const casesHref = getRelativeLocaleUrl(locale, '/cases');
---

<section
    class:list={['hero', 'wrapper', props.class]}
    data-key-visual-shape="/static/img/key-visual-hero.jpg"
    aria-label="Intro"
    {...props}
>
    <p class="hero__eyebrow label" data-reveal="instant">
        {tp('Portfolio', locale)}
    </p>
    <h1 class="hero__title h1" data-reveal="scatter-instant">
        {tp('Andrew Melnichenko', locale)}
    </h1>
    <p class="hero__lead text-lead" data-reveal="instant" data-reveal-delay="0.08">
        {tp(copy.lead, locale)}
    </p>
    <p class="hero__subline text-default" data-reveal="instant" data-reveal-delay="0.16">
        {tp(copy.subline, locale)}
    </p>
    <div class="hero__actions" data-reveal="instant" data-reveal-delay="0.24">
        <a class="hero__cta label-m link" href={casesHref} data-press>
            {tp(copy.cases, locale)}
        </a>
        <a class="hero__cta label-m link" href="#contact" data-press>
            {tp(copy.contact, locale)}
        </a>
    </div>
</section>

<style lang="scss" is:global>
    @use './Hero';
</style>
