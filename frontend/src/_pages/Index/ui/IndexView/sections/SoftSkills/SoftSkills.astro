---
import type { HTMLAttributes } from 'astro/types';
import type { AppLocale } from '@/shared/config';
import { tp } from '@/shared/lib/formatting';
import type { RawProps } from './types';

type Props = HTMLAttributes<'section'> & RawProps;

const { ...props } = Astro.props;
const locale = Astro.currentLocale as AppLocale;

const copy = {
    ru: {
        title: 'Как со мной работать',
        items: [
            'Спокойно уточняю детали по макету, пока всё не ясно',
            'Держу сроки и пишу, если что-то съезжает',
            'Легко работаю с дизайнером и менеджером',
            'Не пропадаю на правках — довожу до конца',
        ],
    },
    en: {
        title: 'Working with me',
        items: [
            'I ask until the mockup is clear',
            'I keep deadlines and flag risks early',
            'Easy to work with for designers and PMs',
            'I stay through feedback rounds',
        ],
    },
}[locale];
---

<section
    class:list={['soft-skills', 'wrapper', props.class]}
    data-key-visual-shape="/static/img/key-visual-about.jpg"
    {...props}
    aria-labelledby="soft-skills-title"
>
    <h2 class="soft-skills__title" id="soft-skills-title" data-reveal="scatter">
        {tp(copy.title, locale)}
    </h2>
    <ul class="soft-skills__list list-unstyled">
        {copy.items.map((item, index) => (
            <li class="soft-skills__item" data-reveal data-reveal-delay={index * 0.06}>
                {tp(item, locale)}
            </li>
        ))}
    </ul>
</section>

<style lang="scss" is:global>
    @use './SoftSkills';
</style>
