---
import type { HTMLAttributes } from 'astro/types';
import type { AppLocale } from '@/shared/config';
import { tp } from '@/shared/lib/formatting';
import { sanitizeHtml } from '@/shared/lib/utils';
import type { RawProps } from './types';

type Props = HTMLAttributes<'section'> & RawProps;

const { ...props } = Astro.props;
const locale = Astro.currentLocale as AppLocale;

const copy = {
    ru: {
        title: 'Как со мной работать',
        description:
            'Пришлите ТЗ, идеи или задачу, которую хотите решить.<br>Дальше разберёмся вместе: оценю объём и спокойно доведу работу до релиза.',
    },
    en: {
        title: 'Working with me',
        description:
            "Send a brief, ideas, or the problem you want to solve.<br>From there we'll figure it out together: I'll estimate the scope and calmly take the work through to release.",
    },
}[locale];
---

<section class:list={['soft-skills', props.class]} {...props} aria-labelledby="soft-skills-title">
    <h2 class="soft-skills__title h2" id="soft-skills-title" data-reveal="scatter">
        {tp(copy.title, locale)}
    </h2>
    <p
        class="soft-skills__text text-m"
        data-reveal="instant"
        data-reveal-delay="0.16"
        set:html={sanitizeHtml(tp(copy.description, locale))}
    />
</section>

<style lang="scss" is:global>
    @use './SoftSkills';
</style>
