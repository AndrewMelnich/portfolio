---
import type { HTMLAttributes } from 'astro/types';
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { AppLocale } from '@/shared/config';
import { SOCIALS } from '@/shared/config';
import { tp } from '@/shared/lib/formatting';
import type { RawProps } from './types';

type Props = HTMLAttributes<'article'> & RawProps;

const { item, class: className, ...props } = Astro.props;
const locale = Astro.currentLocale as AppLocale;

const title = item.title[locale];
const casesHref = getRelativeLocaleUrl(locale, 'cases');
const telegramHref = SOCIALS.find((social) => social.id === 'telegram')?.href ?? 'https://t.me/andrew_melnich';
const backLabel = locale === 'en' ? '← Back' : '← Назад';
const roleLabel =
    item.role === 'built' ? (locale === 'en' ? 'From scratch' : 'С нуля') : locale === 'en' ? 'Support' : 'Поддержка';
const liveLabel = locale === 'en' ? 'Visit site' : 'Смотреть сайт';
const ctaLabel = locale === 'en' ? 'Discuss a project like this' : 'Обсудить похожий проект';
const keyVisualShape = item.liveUrl ? `/nextapi/site-icon/?src=${encodeURIComponent(item.liveUrl)}` : '';
---

<article
    class:list={['case-view', className]}
    {...props}
    data-key-visual-shape={keyVisualShape}
    data-key-visual-shape-fallback={item.image?.src}
>
    <div class="case-view__inner wrapper">
        <a class="case-view__back label-m link" href={casesHref} data-press>
            {tp(backLabel, locale)}
        </a>

        {item.image && (
            <div class="case-view__media js-key-visual-anchor">
                <img
                    class="case-view__image"
                    src={item.image.src}
                    alt={item.image.alt ?? title}
                    width={item.image.width ?? 1440}
                    height={item.image.height ?? 900}
                    title={item.image.title}
                    loading="eager"
                    fetchpriority="high"
                    decoding="async"
                    transition:name="case-active-image"
                />
            </div>
        )}

        <p class="case-view__role label" data-reveal data-reveal-delay={0.04}>
            {tp(roleLabel, locale)}
        </p>
        <h1 class="case-view__title h1">{tp(title, locale)}</h1>
        <p class="case-view__lead text-lead-l" data-reveal data-reveal-delay={0.1}>
            {tp(item.teaser[locale], locale)}
        </p>

        <div class="case-view__description">
            {item.description[locale].map((paragraph, index) => (
                <p class="case-view__text text-m" data-reveal data-reveal-delay={(index + 1) * 0.15}>
                    {tp(paragraph, locale)}
                </p>
            ))}
        </div>

        {item.tags.length > 0 && (
            <ul class="case-view__tags list-unstyled">
                {item.tags.map((tag, index) => (
                    <li class="case-view__tag text-tag" data-reveal data-reveal-delay={index * 0.04}>
                        {tp(tag, locale)}
                    </li>
                ))}
            </ul>
        )}

        {item.liveUrl && (
            <p class="case-view__live-wrap" data-reveal>
                <a
                    class="case-view__live text-m link link--underlined"
                    href={item.liveUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    data-press
                >
                    {tp(liveLabel, locale)}
                </a>
            </p>
        )}

        <p class="case-view__cta-wrap" data-reveal>
            <a
                class="case-view__cta text-m link link--underlined"
                href={telegramHref}
                target="_blank"
                rel="noopener noreferrer"
                data-press
            >
                {tp(ctaLabel, locale)}
            </a>
        </p>
    </div>
</article>

<style lang="scss" is:global>
    @use './styles';
</style>
