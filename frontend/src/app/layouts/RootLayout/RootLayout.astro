---
import '@/app/css/app.scss';
import { PUBLIC_FIGMA_FILE_ID, PUBLIC_FIGMA_TOKEN, PUBLIC_HOST } from 'astro:env/client';
import { DEFAULT_LOCALE, LOCALES, WEBSITE_METADATA, type AppLocale } from '@/shared/config';
import { getPathWithoutFilter } from '@/shared/lib/chpu';
import type { PageMeta } from '@/shared/model';
import InlineScript from '@/shared/ui/InlineScript';
import LayoutGrid from '@/shared/ui/LayoutGrid';
import SkipLink from '@/shared/ui/SkipLink';
type Props = {
    htmlClass?: string;
    meta: PageMeta;
};

const locale = Astro.currentLocale as AppLocale;
const { htmlClass, meta } = Astro.props;
const { pathname } = Astro.url;

const cleanPath = getPathWithoutFilter(pathname || '');
const basePath = cleanPath.replace(new RegExp(`^/${locale}(/|$)`), '/') || '/';

const getLocalizedUrl = (l: string) => {
    const host = (PUBLIC_HOST || '').replace(/\/$/, '');
    const prefix = l === DEFAULT_LOCALE ? '' : `/${l}`;
    const fullPath = `${prefix}${basePath}`.replace(/\/+/g, '/');
    return `${host}${fullPath}`;
};

const noJsScript = "document.documentElement.classList.replace('no-js', 'js');";
const speculationRules = JSON.stringify({
    prerender: [
        {
            source: 'document',
            where: {
                and: [
                    { href_matches: '/*' },
                    { not: { href_matches: '/admin/*' } },
                    { not: { href_matches: '/*.md' } },
                    { not: { href_matches: '/*.xml' } },
                    { not: { href_matches: '/*.txt' } },
                    { not: { href_matches: '/*.jsonld' } },
                    { not: { selector_matches: '[data-no-speculate]' } },
                    { not: { selector_matches: '[rel~=external]' } },
                    { not: { selector_matches: '[rel~=nofollow]' } },
                ],
            },
            eagerness: 'moderate',
        },
    ],
    prefetch: [
        {
            source: 'document',
            where: {
                and: [
                    { href_matches: '/*' },
                    { not: { href_matches: '/admin/*' } },
                    { not: { selector_matches: '[data-no-speculate]' } },
                    { not: { selector_matches: '[rel~=external]' } },
                    { not: { selector_matches: '[rel~=nofollow]' } },
                ],
            },
            eagerness: 'conservative',
        },
    ],
});
---

<html lang={locale} class:list={['no-js', htmlClass]}>
    <head>
        <meta charset="utf-8" />
        <title>{meta.title}</title>
        <meta name="viewport" content="width=device-width, viewport-fit=cover" />
        <meta name="description" content={meta.description} />

        {PUBLIC_HOST && <meta property="og:url" content={`${(PUBLIC_HOST || '').replace(/\/$/, '')}${pathname}`} />}
        <meta property="og:locale" content={locale} />
        <meta property="og:type" content="website" />
        <meta property="og:title" content={meta.title} />
        <meta property="og:description" content={meta.description} />
        <meta property="og:image" content={meta.ogImage} />
        <meta name="twitter:card" content="summary" />
        <meta name="twitter:image" content={meta.ogImage} />
        <meta name="twitter:title" content={meta.title} />
        <meta name="twitter:description" content={meta.description} />

        <link rel="icon" type="image/svg+xml" href="/static/img/favicon.svg" />
        <link rel="apple-touch-icon" href={WEBSITE_METADATA.icons.appleTouch} />
        <link rel="manifest" href="/site.webmanifest" />
        <meta name="theme-color" content={WEBSITE_METADATA.themeColor} />

        {PUBLIC_HOST && (
            <>
                <link rel="canonical" href={getLocalizedUrl(locale)} />
                {LOCALES.length > 1 && (
                    <>
                        {LOCALES.map((l) => (
                            <link rel="alternate" hreflang={l} href={getLocalizedUrl(l)} />
                        ))}
                        <link rel="alternate" hreflang="x-default" href={getLocalizedUrl(DEFAULT_LOCALE)} />
                    </>
                )}
            </>
        )}

        <!-- <link
            rel="preload"
            href="/static/fonts/TT_Ramillas_Light.woff2"
            as="font"
            type="font/woff2"
            crossorigin="anonymous"
        /> -->

        <InlineScript code={noJsScript} />
        <script>
            import '@/app/app.ts';
        </script>
        <InlineScript type="speculationrules" code={speculationRules} />
        <slot name="head" />
    </head>
    <body>
        <SkipLink />
        <main id="main" class="main" tabindex="-1">
            <slot />
        </main>
        {import.meta.env.DEV && (
            <>
                <LayoutGrid />
                {PUBLIC_FIGMA_TOKEN && PUBLIC_FIGMA_FILE_ID && (
                    <script
                        type="module"
                        src="https://unpkg.com/@rocketmark/figma-testing-library/dist/figma-testing-library/figma-testing-library.esm.js"
                    />
                )}
            </>
        )}
    </body>
</html>
