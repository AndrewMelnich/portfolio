{
    "name": "portfolio",
    "type": "module",
    "version": "0.0.1",
    "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6",
    "engines": {
        "node": ">=24.11 <25",
        "pnpm": ">=12 <13"
    },
    "scripts": {
        "dev": "astro dev --host",
        "build": "astro build",
        "postbuild": "node ./scripts/prepare-sitemap.js",
        "preview": "astro preview",
        "start": "dotenv run -q -- node build/server/entry.mjs",
        "astro": "astro",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "lint:js": "eslint --cache --cache-location .eslintcache --fix \"src/**/*.{js,jsx,ts,tsx,astro}\" \"tests/e2e/**/*.ts\"",
        "lint:css": "stylelint --cache --cache-location .stylelintcache \"src/**/*.{css,scss,astro}\" --fix",
        "lint:fsd": "steiger ./src",
        "lint:pages": "node ./scripts/lint-pages.mjs",
        "lint:feature-map": "node ./scripts/lint-feature-map.mjs",
        "lint:breakpoints": "node ./scripts/lint-breakpoints.mjs",
        "fallow:scan": "fallow",
        "fallow:audit": "fallow audit",
        "lint": "concurrently 'pnpm lint:js' 'pnpm lint:css' 'pnpm lint:fsd'",
        "verify:path": "bash ./scripts/verify-path.sh",
        "verify:changed": "bash ./scripts/verify-changed.sh",
        "pc": "concurrently 'pnpm tsc' 'pnpm lint' 'pnpm format:check'",
        "setup": "bash ./scripts/setup.sh",
        "audit": "pnpm audit --prod --audit-level=high",
        "outdated": "pnpm outdated --long",
        "tsc": "tsc --noEmit",
        "test": "vitest run",
        "test:ci": "vitest run",
        "test:ui": "vitest --ui",
        "test:watch": "vitest",
        "test:html": "node ./scripts/run-html-tests.mjs",
        "test:general": "npx playwright test tests/general/*",
        "test:e2e": "playwright test -c playwright.e2e.config.ts",
        "test:general:ci": "dotenv run -q -- sh -c 'pnpm test:general'",
        "mkar": "node ./codegen/make-api-request.js",
        "mkrc": "node ./codegen/make-react-component.js",
        "mkac": "node ./codegen/make-astro-component.js",
        "icons": "node ./scripts/generate-icon-types.js",
        "pwa-icons": "node ./scripts/generate-pwa-icons.mjs",
        "uml": "node ./scripts/uml-viewer/uml-viewer.mjs",
        "figma:diff": "node ./scripts/figma-diff.mjs",
        "figma:grid": "node ./scripts/figma-grid.mjs",
        "figma:snapshot": "node ./scripts/figma-mcp-to-snapshot.mjs",
        "figma:css-tree": "node ./scripts/figma-section-css-tree.mjs",
        "figma:css-tree-report": "node ./scripts/figma-css-tree-report.mjs",
        "ts-zod": "dotenv run -q -- sh -c 'node ./generate-zod-schemas-openapi.mjs $DOCS_API_HOST/docs/api.json'",
        "api-types": "dotenv run -q -- sh -c 'openapi-typescript $DOCS_API_HOST/docs/api.json -o src/api/generated/api.d.ts && oxfmt src/api/generated/api.d.ts'",
        "api": "concurrently 'pnpm api-types' 'pnpm ts-zod'",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build"
    },
    "dependencies": {
        "@astrojs/node": "^11.1.8",
        "@astrojs/react": "^7.1.0",
        "@astrojs/sitemap": "^3.7.4",
        "@floating-ui/dom": "^1.8.0",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@uppy/core": "^6.3.0",
        "@uppy/status-bar": "^6.0.1",
        "@uppy/xhr-upload": "^6.0.1",
        "astro": "^7.4.0",
        "delegate": "^3.2.0",
        "isomorphic-dompurify": "^4.6.0",
        "lodash.debounce": "^4.0.8",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "rollbar": "^4.0.0",
        "schema-dts": "^2.1.0",
        "server-only": "file:./vendor/server-only",
        "sharp": "^0.35.5",
        "typograf": "^7.8.0",
        "validator": "^13.15.35",
        "yaml": "2.9.1",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@astrojs/compiler-rs": "^0.5.1",
        "@eslint/eslintrc": "^3.3.7",
        "@eslint/js": "^10.0.1",
        "@feature-sliced/eslint-config": "^0.1.1",
        "@feature-sliced/steiger-plugin": "^0.8.0",
        "@playwright/test": "^1.64.1",
        "@storybook-astro/framework": "^1.12.0",
        "@storybook/addon-mcp": "^0.7.0",
        "@storybook/builder-vite": "^10.6.2",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/html-validator": "^5.0.6",
        "@types/jsdom": "^30.0.0",
        "@types/lodash.debounce": "^4.0.9",
        "@types/validator": "^13.15.10",
        "@typescript-eslint/parser": "^8.71.2",
        "@typescript/native": "npm:typescript@^7.0.2",
        "@vitest/ui": "^5.0.5",
        "astro-eslint-parser": "^3.2.0",
        "axe-core": "^4.14.0",
        "change-case": "^5.4.4",
        "concurrently": "^10.0.6",
        "dotenv": "^18.0.8",
        "dotenv-cli": "^11.0.0",
        "eslint": "^10.13.0",
        "eslint-plugin-astro": "^3.2.1",
        "eslint-plugin-boundaries": "^7.2.0",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-no-unsanitized": "^4.1.5",
        "eslint-plugin-react-compiler": "19.1.0-rc.2",
        "eslint-plugin-sonarjs": "^4.2.2",
        "fallow": "^3.33.1",
        "html-validator": "^6.0.1",
        "jsdom": "^30.1.1",
        "lint-staged": "^17.6.0",
        "openapi-typescript": "^7.13.0",
        "oxfmt": "^0.74.0",
        "playwright": "^1.64.1",
        "pngjs": "^7.0.0",
        "postcss-easings": "^4.0.0",
        "postcss-html": "^2.0.0",
        "sass-embedded": "^1.105.2",
        "steiger": "^0.7.0",
        "storybook": "^10.6.2",
        "stylelint": "^17.16.0",
        "stylelint-config-html": "^2.0.0",
        "stylelint-config-standard-scss": "^17.0.0",
        "stylelint-order": "^8.1.2",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "typescript-eslint": "^8.71.2",
        "vite": "^8.3.1",
        "vitest": "^5.0.5"
    }
}
