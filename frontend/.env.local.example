# Порт, на котором крутится frontend-приложение
PORT=3000
# env: local / development / production
PUBLIC_ENV=local
# URL сайта
PUBLIC_HOST=https://domain.ru
# URL сайта, где живет API (обычно равно значению PUBLIC_HOST)
PUBLIC_API_HOST=https://domain.ru
# URL сайта, где живет документация API и OpenAPI спецификация
DOCS_API_HOST=https://domain.ru
